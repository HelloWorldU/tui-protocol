{
  "name": "tui-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prototype:pi-host": "vite --config prototypes/integration/pi-session/vite.config.ts",
    "build:pi-host": "vite build --config prototypes/integration/pi-session/vite.config.ts --outDir ../../../.tmp/pi-host-dist --emptyOutDir",
    "prototype:pi-session": "node prototypes/integration/pi-session/replay.ts",
    "test:pi-session": "node --test prototypes/integration/pi-session/*.test.ts",
    "prototype:pty-stalled": "vite --config prototypes/integration/pty-pressure/vite.config.ts --mode stalled",
    "build:pty-stalled": "vite build --config prototypes/integration/pty-pressure/vite.config.ts --mode stalled --outDir ../../../.tmp/pty-stalled-dist --emptyOutDir",
    "prototype:pty-composed": "vite --config prototypes/integration/pty-pressure/vite.config.ts --mode composed",
    "build:pty-composed": "vite build --config prototypes/integration/pty-pressure/vite.config.ts --mode composed --outDir ../../../.tmp/pty-composed-dist --emptyOutDir",
    "prototype:pty-upstream": "node prototypes/integration/pty-pressure/upstream-probe.ts",
    "test:pty-upstream": "node --test prototypes/integration/pty-pressure/upstream.test.ts",
    "prototype:pty-pressure": "vite --config prototypes/integration/pty-pressure/vite.config.ts",
    "build:pty-pressure": "vite build --config prototypes/integration/pty-pressure/vite.config.ts --outDir ../../../.tmp/pty-pressure-dist --emptyOutDir",
    "prototype:ingress-pressure": "node prototypes/integration/ingress-pressure/probe.ts",
    "example:multi-round": "vite --config examples/multi-round/vite.config.ts",
    "build:multi-round-example": "vite build --config examples/multi-round/vite.config.ts --outDir ../../.tmp/multi-round-example-dist --emptyOutDir",
    "prepare:multi-round-example": "node examples/multi-round/prepare.ts",
    "build:terminal": "node terminal/build.ts",
    "example:terminal": "vite --config examples/terminal-host/vite.config.ts",
    "build:terminal-example": "vite build --config examples/terminal-host/vite.config.ts --outDir ../../.tmp/terminal-example-dist --emptyOutDir",
    "example:streaming": "vite --config prototypes/integration/pty-demo/streaming-example.config.ts",
    "prepare:streaming-example": "node examples/streaming-text/prepare.ts",
    "build:sdk": "node sdk/build.ts",
    "build:xterm-browser-input-state": "vite build prototypes/integration/xterm-browser-input-state --outDir ../../../.tmp/xterm-browser-input-state-dist --emptyOutDir",
    "build:xterm-browser-metadata": "vite build prototypes/integration/xterm-browser-metadata --outDir ../../../.tmp/xterm-browser-metadata-dist --emptyOutDir",
    "build:xterm-browser-protocol-endpoint": "vite build prototypes/integration/xterm-browser-protocol-endpoint --outDir ../../../.tmp/xterm-browser-protocol-endpoint-dist --emptyOutDir",
    "build:xterm-browser-search": "vite build prototypes/integration/xterm-browser-search --outDir ../../../.tmp/xterm-browser-search-dist --emptyOutDir",
    "build:xterm-browser-selection": "vite build prototypes/integration/xterm-browser-selection --outDir ../../../.tmp/xterm-browser-selection-dist --emptyOutDir",
    "prototype:xterm-browser-input-state": "vite prototypes/integration/xterm-browser-input-state",
    "prototype:xterm-browser-metadata": "vite prototypes/integration/xterm-browser-metadata",
    "prototype:xterm-browser-protocol-endpoint": "vite prototypes/integration/xterm-browser-protocol-endpoint",
    "prototype:xterm-browser-search": "vite prototypes/integration/xterm-browser-search",
    "prototype:xterm-browser-selection": "vite prototypes/integration/xterm-browser-selection",
    "prototype:pty-transport": "node prototypes/integration/pty-transport/probe.ts",
    "prototype:pty-demo": "vite --config prototypes/integration/pty-demo/vite.config.ts",
    "build:pty-demo": "vite build --config prototypes/integration/pty-demo/vite.config.ts --outDir ../../../.tmp/pty-demo-dist --emptyOutDir",
    "test": "node --test scripts/*.test.ts examples/multi-round/*.test.mjs examples/streaming-text/*.test.ts examples/streaming-text/*.test.mjs sdk/test/*.test.ts terminal/test/*.test.ts prototypes/block-model/model.test.ts prototypes/integration/ingress-pressure/*.test.ts prototypes/integration/pi-session/*.test.ts prototypes/integration/pty-demo/*.test.ts prototypes/integration/pty-pressure/report.test.ts prototypes/integration/xterm-protocol-endpoint/*.test.ts protocol/test/*.test.ts prototypes/xterm-headless/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p prototypes/integration/pi-session/tsconfig.json"
  },
  "devDependencies": {
    "@tui-protocol/protocol": "workspace:*",
    "@tui-protocol/sdk": "workspace:*",
    "@tui-protocol/terminal": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/ws": "8.18.1",
    "node-pty": "1.1.0",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "ws": "8.21.3"
  },
  "dependencies": {
    "@xterm/addon-search": "0.16.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0"
  }
}
