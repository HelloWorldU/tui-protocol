{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["examples/**/*.ts", "protocol/**/*.ts", "prototypes/**/*.ts", "sdk/**/*.ts", "terminal/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["prototypes/integration/pi-session"]
}
